# Copiez ce fichier en .env (non commite) et renseignez vos valeurs.
# Sur Render, definissez ces memes variables dans Environment.

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Base de donnees Supabase (connection string du Pooler)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Emails transactionnels Brevo
BREVO_API_KEY=xkeysib-xxx
EMAIL_SENDER=contact@votre-domaine.com

# Cle d'acces aux endpoints /api/v1/admin/* (generer une valeur aleatoire longue)
# Obligatoire : sans elle les endpoints admin renvoient 503.
ADMIN_API_KEY=

# Notifications de visite en direct (optionnel : si vide, /api/v1/track ne notifie rien)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analyse de convergence (convergence_analyzer.py)
GEMINI_API_KEY=
